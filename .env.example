# 请将本文件复制为.env文件，并填写你的账号信息
# 注意：.env 包含真实凭据，已被 .gitignore 忽略，请勿提交到版本库

# 南方科技大学CAS账号
USERNAME=你的学号
PASSWORD=你的密码

# 指定学年与学期
XN=2026-2027
XQ=1

# 调试模式
DEBUG=False

# 程序输出目录（可选，默认 output/）
# 课程信息 course_info.txt、课表 course_schedule.xlsx、调试响应 resp.txt 都会输出到这里
# OUTPUT_DIR=output

# 课表导出文件路径（可选，默认 output/course_schedule.xlsx）
# SCHEDULE_FILE=output/course_schedule.xlsx

# ICS 日历课表导出文件路径（可选，默认 output/course_schedule.ics）
# ICS_FILE=output/course_schedule.ics

# 开学第一周周一日期（格式 YYYY-MM-DD），用于 ICS 课表计算具体上课日期
# 不配置则跳过 ICS 课表导出
# SEMESTER_START=2026-09-07
